---
import Base from "../layouts/Base.astro";
import { languages, dictFor, defaultLang } from "../lib/i18n";

const en = dictFor(defaultLang);
---
<Base lang="en" title={en.ui.siteTitle} description={en.ui.description}>
  <main class="chooser">
    <div class="sign">
      <p class="sign__kicker">Živé námestie</p>
      <p class="sign__badge">oživa</p>
    </div>
    <ul class="chooser__list">
      {languages.map((l) => (
        <li><a href={`/${l.code}/`} hreflang={l.dict.meta.htmlLang} lang={l.dict.meta.htmlLang}>{l.dict.meta.name}</a></li>
      ))}
    </ul>
    <noscript><p>{en.ui.chooseLanguage}</p></noscript>
  </main>
  <script is:inline src="/js/lang.js" data-langs={languages.map((l) => l.code).join(",")} data-default={defaultLang}></script>
</Base>
